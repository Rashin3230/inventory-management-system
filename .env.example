# Copy to backend/.env.local and frontend/.env.local

# --- backend/.env.local ---
PORT=5000
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb://<username>:<password>@<host>/inventory?ssl=true&authSource=admin&retryWrites=true&w=majority
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# --- frontend/.env.local ---
BACKEND_URL=http://localhost:5000
JWT_SECRET=your-super-secret-jwt-key-change-in-production
